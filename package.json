{
  "name": "campus-flow",
  "version": "1.0.2",
  "private": true,
  "description": "本地优先的校招投递工作台",
  "author": "Campus Flow",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/model.test.ts tests/store.test.cjs",
    "desktop": "electron .",
    "dist:win": "npm run test && npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "cn.campusflow.desktop",
    "productName": "校招迹",
    "asar": true,
    "asarUnpack": [
      "electron/ocr.ps1"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "campus-flow-setup-${version}.exe"
    },
    "portable": {
      "artifactName": "campus-flow-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wuzenghui27-wq",
        "repo": "campus-flow"
      }
    ]
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
